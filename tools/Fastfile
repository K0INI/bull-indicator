# Fastlane: signed iOS build + App Store Connect upload using an App Store Connect API key.
# Env: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (contents of the .p8 file). Run from app/ios.
default_platform(:ios)

platform :ios do
  desc "Build signed IPA and upload to App Store Connect"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"]
    )
    setup_ci
    keychain = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")
    # Apple WWDR intermediates so the new identity validates on the runner
    %w[AppleWWDRCAG3 AppleWWDRCAG4].each do |c|
      sh("curl -fsSL -o /tmp/#{c}.cer https://www.apple.com/certificateauthority/#{c}.cer && security import /tmp/#{c}.cer -k #{keychain} || true")
    end
    # Legacy "iOS Distribution" type: the team's "Distribution" slots are full
    cert(api_key: api_key, generate_apple_certs: false, keychain_path: keychain, keychain_password: "")
    sigh(api_key: api_key, app_identifier: "com.koini.bullindicator", force: true, cert_id: lane_context[SharedValues::CERT_CERTIFICATE_ID])
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      team_id: "WW8T4Y4422",
      bundle_identifier: "com.koini.bullindicator",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      code_sign_identity: "iPhone Distribution"
    )
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { "com.koini.bullindicator" => lane_context[SharedValues::SIGH_NAME] }
      }
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
